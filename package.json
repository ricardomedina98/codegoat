{
  "name": "codegoat",
  "version": "0.7.0",
  "description": "AI-powered code review and documentation generator for small teams",
  "type": "module",
  "bin": {
    "codegoat": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "code-review",
    "documentation",
    "cli",
    "ai",
    "llm",
    "openai",
    "developer-tools",
    "static-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opengoat/codegoat.git"
  },
  "homepage": "https://github.com/opengoat/codegoat#readme",
  "bugs": {
    "url": "https://github.com/opengoat/codegoat/issues"
  },
  "author": "OpenGoat",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "ignore": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0"
  }
}
